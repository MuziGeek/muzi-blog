{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "validate:posts": "node source/_posts/temp/validate-blog-titles.js",
    "theme:sync-sources": "node tooling/sync-shokax-sources.mjs",
    "theme:prepare": "node tooling/prepare-shokax.mjs",
    "theme:verify": "node tooling/verify-shokax-scripts.mjs",
    "theme:check": "node tooling/check-shokax-update.mjs",
    "prebuild": "pnpm run validate:posts && pnpm run theme:prepare && pnpm run theme:verify",
    "build": "hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "predeploy": "pnpm run validate:posts && pnpm run theme:prepare && pnpm run theme:verify",
    "server": "pnpm run theme:prepare && pnpm run theme:verify && hexo server"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "@algolia/client-search": "^5.34.1",
    "@common.js/p-limit": "6.1.0",
    "@waline/client": "^3.6.0",
    "algoliasearch": "^5.34.1",
    "es-toolkit": "^1.39.8",
    "esbuild": "^0.25.8",
    "hana-img-viewer": "^1.2.3",
    "hexo": "7.3.0",
    "hexo-algoliasearch": "2.0.1",
    "hexo-cli": "^4.3.2",
    "hexo-feed": "1.1.2",
    "hexo-fs": "^5.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^3.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-pagination": "4.0.0",
    "hexo-renderer-aether": "0.0.6",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-multi-markdown-it-plus": "^0.1.0",
    "hexo-renderer-pug": "3.0.0",
    "hexo-renderer-stylus": "^3.0.0",
    "hexo-server": "^3.0.0",
    "hexo-theme-shokax": "file:themes/shokax",
    "hexo-util": "3.3.0",
    "instantsearch.js": "^4.79.2",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.22",
    "mouse-firework": "0.1.1",
    "nyx-player": "0.1.1",
    "quicklink": "2.3.0",
    "shokax-uikit": "0.0.5",
    "theme-shokax-anime": "0.0.8",
    "theme-shokax-pjax": "0.0.3",
    "twikoo": "1.6.44",
    "unlazy": "0.12.1",
    "vue": "^3.5.18",
    "yocto-queue": "^1.2.2"
  }
}
